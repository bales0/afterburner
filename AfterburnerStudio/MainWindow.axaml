<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:AfterburnerStudio.Controls"
        x:Class="AfterburnerStudio.MainWindow"
        Width="1250" Height="880" MinWidth="970" MinHeight="680"
        Title="Afterburner Studio • GAL / PLD Programmer"
        Background="#F4F7FB">
  <Window.Styles>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#17304A"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#52687D"/>
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D5E0E9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="Button.mainaction">
      <Setter Property="Background" Value="#146D9C"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="#17304A"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#DCEAF4"/>
      <Setter Property="Foreground" Value="#17304A"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#BED8EA"/>
      <Setter Property="Foreground" Value="#17304A"/>
    </Style>
    <Style Selector="Button.mainaction /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#146D9C"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.mainaction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#105980"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.mainaction:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#0B4263"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E2E8EF"/>
      <Setter Property="Foreground" Value="#52687D"/>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="18" RowSpacing="12">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
      <TextBlock Classes="title" Text="Afterburner Studio"/>
      <!-- Temporary visible build identification, so installed/stale GUI builds cannot be confused. -->
      <TextBlock Name="UiBuildMarker" Text="Refined layout + LIVE VPP • UI update 2026-10-31C"
                 Classes="muted" FontSize="12" VerticalAlignment="Center"/>
    </StackPanel>
    <!-- Hardware connection applies to all tabs, including VPP measurement. -->
    <Border Grid.Row="1" Name="ConnectionInputs" Classes="panel" Padding="12">
      <StackPanel Spacing="7">
        <TextBlock Text="Programmer connection" FontWeight="Bold" FontSize="17" Foreground="#17304A"/>
        <Grid ColumnDefinitions="1.35*,1.2*,1*" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="Detected serial port:"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <ComboBox Name="PortList" PlaceholderText="Select serial port" SelectionChanged="OnPortSelected"/>
              <Button Grid.Column="1" Content="Refresh" Click="OnRefreshPorts"/>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="Port (manual / selected):"/>
            <TextBox Name="PortBox" Watermark="COM5 / /dev/ttyUSB0" TextChanged="OnInputChanged"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Text="Programmer PCB revision (manual):"/>
            <ComboBox Name="BoardBox" SelectedIndex="2" SelectionChanged="OnSetupChanged">
              <ComboBoxItem Content="3.0"/><ComboBoxItem Content="3.1"/>
              <ComboBoxItem Content="3.2+"/><ComboBoxItem Content="Older, modified (verified)"/>
            </ComboBox>
          </StackPanel>
        </Grid>
        <TextBlock Name="ExternalRamStatus" Text="External SRAM: not queried (diagnostics only)" Classes="muted" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <!-- Always-visible operation center. Never hide activity on another tab. -->
    <Border Grid.Row="2" Classes="panel" Padding="12">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="5">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
          <TextBlock Name="OperationHeadline" Text="Ready" FontWeight="Bold" FontSize="16" Foreground="#17304A"/>
          <TextBlock Name="ProgressCaption" Text="No operation running" Classes="muted" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Name="StatusText" Text="Select an operation to begin." TextWrapping="Wrap"/>
        <TextBlock Grid.Row="2" Name="HardwareSummary" Text="Programmer: not connected" Classes="muted" TextWrapping="Wrap"/>
        <ProgressBar Grid.Row="3" Name="BusyBar" Minimum="0" Maximum="100" Value="0" Height="11"/>
        <TextBlock Grid.Row="4" Name="OperationError" IsVisible="False" Foreground="#B42318" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <Button Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Name="CancelButton" Content="Cancel operation"
                Click="OnCancel" IsEnabled="False" VerticalAlignment="Center" MinWidth="140"/>
      </Grid>
    </Border>
    <TabControl Grid.Row="3" Name="Tabs">
      <TabItem Header="  Programming  ">
        <ScrollViewer>
          <Grid ColumnDefinitions="410,*" ColumnSpacing="14" Margin="0,12,0,6">
            <StackPanel Grid.Column="0" Name="ProgrammingInputs" Spacing="12">
              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Text="1. Target device" Classes="title"/>
                  <TextBlock Text="Device type:"/>
                  <ComboBox Name="ChipBox" SelectionChanged="OnChipChanged" HorizontalAlignment="Stretch"/>
                  <TextBlock Name="ChipSummary" TextWrapping="Wrap" Foreground="#37546F"/>
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="Turn socket power OFF before inserting or removing the device. For identification and programming, use the programmer's required socket power setting (normally ON)."/>
                </StackPanel>
              </Border>
              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Text="2. Programming file and adapter checks" Classes="title"/>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Name="JedPath" TextChanged="OnSourceChanged" Watermark="Select a JEDEC (.jed) or XSVF (.xsvf) file"/>
                    <Button Grid.Column="1" Content="Browse…" Click="OnBrowseJed"/>
                  </Grid>
                  <TextBlock Name="JedStatus" TextWrapping="Wrap" Classes="muted" Text="No file selected."/>
                  <StackPanel Name="JtagErasePanel" IsVisible="False" Spacing="7">
                    <TextBlock Classes="muted" TextWrapping="Wrap"
                      Text="ATF150x: the matching erase XSVF runs first; your design XSVF is programmed afterwards. The erase script is normally selected automatically."/>
                    <Expander Header="Advanced: choose another erase XSVF" IsExpanded="False">
                      <StackPanel Spacing="5" Margin="0,6,0,0">
                        <TextBlock Text="Optional erase XSVF override (must match the selected ATF150x):" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                          <TextBox Name="EraseXsvfPath" TextChanged="OnInputChanged" Watermark="Normally leave blank"/>
                          <Button Grid.Column="1" Content="Browse…" Click="OnBrowseEraseXsvf"/>
                        </Grid>
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                          Text="This is an erase procedure, not your design data. Leave empty to use the matching bundled erase_ATF150x.xsvf file."/>
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                  <CheckBox Name="AdapterCheck" IsCheckedChanged="OnInputChanged" IsVisible="False"><TextBlock Text="I checked the adapter orientation and wiring / JTAG connections" TextWrapping="Wrap"/></CheckBox>
                </StackPanel>
              </Border>

            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="12">
              <Border Classes="panel">
                <StackPanel Spacing="10">
                  <TextBlock Text="3. Operations" Classes="title"/><TextBlock Name="WriteReadiness" TextWrapping="Wrap"/>
                  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="7" RowSpacing="7">
                    <Button Grid.Row="0" Name="IdentifyButton" Content="Identify (PES)" Click="OnIdentify"/>
                    <Button Grid.Row="0" Grid.Column="1" Name="ReadButton" Content="Read and save" Click="OnRead"/>
                    <Button Grid.Row="1" Name="EraseButton" Content="Erase" Click="OnErase"/>
                    <Button Grid.Row="1" Grid.Column="1" Name="VerifyButton" Content="Verify only" Click="OnVerify"/>
                    <Button Grid.Row="2" Grid.ColumnSpan="2" Name="WriteButton" Classes="mainaction" Content="WRITE AND VERIFY" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnWriteVerify"/>
                    <Button Grid.Row="3" Grid.ColumnSpan="2" Name="ConditionButton" Content="Condition a new ATF device" Click="OnCondition"/>
                  </Grid>
                  
                </StackPanel>
              </Border>
              <!-- User-facing results are on the Programming page; the log is diagnostic only. -->
              <Border Classes="panel">
                <StackPanel Spacing="8">
                  <TextBlock Text="Operation result" Classes="title"/>
                  <TextBlock Name="ProgrammingResultTitle" Text="No operation performed yet." FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Name="ProgrammingResultDetails" Text="Device information, programmer replies and saved-file results will appear here." TextWrapping="Wrap" Foreground="#37546F"/>
                </StackPanel>
              </Border>
              <Border Classes="panel">
                <StackPanel Spacing="8">
                  <TextBlock Text="Device placement" Classes="title"/>
                  <controls:SocketDiagram Name="Diagram" Height="260" HorizontalAlignment="Stretch"/>
                  <TextBlock Name="AdapterNotice" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#B45309"/>
                  
                </StackPanel>
              </Border>

            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="  VPP calibration  ">
        <ScrollViewer>
          <StackPanel Name="CalibrationInputs" Spacing="12" Margin="0,12,0,6">
            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock Text="Programming voltage calibration" Classes="title"/>
                <TextBlock TextWrapping="Wrap" Text="Remove the chip from the socket OR physically switch OFF VPP to the socket. Measure with a multimeter. Calibration uses the MCP4131/MCP4151 digital potentiometer and stores results in Arduino EEPROM."/>
                <Border Background="#FFF4E5" BorderBrush="#D97706" BorderThickness="1" CornerRadius="6" Padding="10">
                  <TextBlock Text="HIGH VOLTAGE SAFETY: remove the chip from the socket or physically switch OFF VPP voltage to the socket before measurement, adjustment or calibration."
                             TextWrapping="Wrap" Foreground="#92400E" FontWeight="SemiBold"/>
                </Border>
                <CheckBox Name="NoChipCheck" IsCheckedChanged="OnInputChanged" Content="VPP safe: chip removed OR VPP physically disconnected from the socket"/>
                <TextBlock Text="Step 1: adjust the boost converter potentiometer (or R9, depending on the PCB) to about 16.5 V."/>
                <Button Name="VppSetButton" Content="1. Start live VPP adjustment" HorizontalAlignment="Left" Click="OnVppSet"/>
                <TextBlock Text="Step 2: scan 9–16.5 V automatically and store the calibration in EEPROM."/>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                  <TextBlock Text="Measurement offset × 0.01 V:" VerticalAlignment="Center"/>
                  <NumericUpDown Name="OffsetBox" Minimum="-32" Maximum="32" Increment="1" Value="0" Width="110"/>
                  <Button Name="VppCalibrateButton" Content="2. Calibrate and save" Click="OnVppCalibrate"/>
                </StackPanel>
                <TextBlock Text="Step 3: compare the readings with your multimeter. Adjust the offset and repeat calibration if needed."/>
                <Button Name="VppMeasureButton" Content="3. Measure calibration points" HorizontalAlignment="Left" Click="OnVppMeasure"/>
                <Border Background="#EFF6FC" CornerRadius="8" Padding="12">
                  <StackPanel Spacing="9">
                    <TextBlock Text="VPP measurements — live results" FontSize="17" FontWeight="Bold" Foreground="#17304A"/>
                    <TextBlock Name="VppOffsetText" Text="Offset: not measured" Foreground="#37546F"/>
                    <TextBlock Name="VppCurrentStep" Text="Ready to start measurement." FontWeight="SemiBold" Foreground="#146D9C" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                      <TextBlock Grid.Row="0" Text="4.2–5.0 V"/>
                      <TextBlock Grid.Row="0" Grid.Column="1" Name="Vpp5Text" Text="Waiting" HorizontalAlignment="Left"/>
                      <TextBlock Grid.Row="1" Text="9.0 V"/>
                      <TextBlock Grid.Row="1" Grid.Column="1" Name="Vpp9Text" Text="Waiting" HorizontalAlignment="Left"/>
                      <TextBlock Grid.Row="2" Text="10.0 V"/>
                      <TextBlock Grid.Row="2" Grid.Column="1" Name="Vpp10Text" Text="Waiting" HorizontalAlignment="Left"/>
                      <TextBlock Grid.Row="3" Text="12.0 V"/>
                      <TextBlock Grid.Row="3" Grid.Column="1" Name="Vpp12Text" Text="Waiting" HorizontalAlignment="Left"/>
                      <TextBlock Grid.Row="4" Text="14.0 V"/>
                      <TextBlock Grid.Row="4" Grid.Column="1" Name="Vpp14Text" Text="Waiting" HorizontalAlignment="Left"/>
                      <TextBlock Grid.Row="5" Text="16.0 V"/>
                      <TextBlock Grid.Row="5" Grid.Column="1" Name="Vpp16Text" Text="Waiting" HorizontalAlignment="Left"/>
                    </Grid>
                    <TextBlock Name="CalibrationResult" Text="Measurement data will appear here during the operation." Foreground="#37546F" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="  Diagnostic log  ">
        <Border Classes="panel" Margin="0,12,0,6">
          <Grid RowDefinitions="Auto,*" RowSpacing="7">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="Diagnostic log (advanced troubleshooting only)" FontSize="17" FontWeight="Bold"/>
              <Button Content="Save log…" Click="OnSaveLog"/>
              <Button Content="Clear log" Click="OnClearLog"/>
            </StackPanel>
            <TextBox Grid.Row="1" Name="LogBox" FontFamily="Consolas,DejaVu Sans Mono" FontSize="12"
                     AcceptsReturn="True" TextWrapping="NoWrap" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
          </Grid>
        </Border>
      </TabItem>
    </TabControl>
    
  </Grid>
</Window>




